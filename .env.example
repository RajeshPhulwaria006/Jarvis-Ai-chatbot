# --- API KEYS ---
GROQ_API_KEY="gsk_...CC"
NEWS_API_KEY="b46...7ae"

# --- LLM CONFIGURATION ---
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# true = microphone input
# false = typed terminal input
JARVIS_VOICE_MODE=true

# CLOUD SPEECH RECOGNITION 
JARVIS_STT_MODEL=whisper-large-v3-turbo

# Multilingual Whisper model; downloaded on first use
JARVIS_LOCAL_STT_MODEL=tiny

JARVIS_MAX_RECORD_SECONDS=12
JARVIS_END_SILENCE_SECONDS=0.9

# Natural Indian English voice
JARVIS_EDGE_EN_VOICE=en-IN-PrabhatNeural

# Natural Hindi voice
JARVIS_EDGE_HI_VOICE=hi-IN-MadhurNeural
